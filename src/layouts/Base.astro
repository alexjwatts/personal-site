---
import '@fontsource-variable/instrument-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import { site } from '../site';

const { title, description } = Astro.props;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description ?? site.intro} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ? `${title} · ${site.name}` : site.name}</title>
  </head>
  <body>
    <header class="bar">
      <a class="brand" href="/">{site.name}</a>
      {/* Every page sits behind one button, a small wireframe globe that slowly turns. Hovering (or tapping) it grows
          the globe into a pill to the left, with the links inside, so the button and the menu are one shape. */}
      <div class="dock">
        <button class="globe-button" type="button" aria-label="Menu" aria-controls="menu" aria-expanded="false">
          <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <circle cx="20" cy="20" r="14" />
            <ellipse class="globe-meridian" cx="20" cy="20" rx="14" ry="14" />
            <ellipse class="globe-meridian globe-meridian-late" cx="20" cy="20" rx="14" ry="14" />
            <path d="M6 20h28M8.5 13h23M8.5 27h23" opacity="0.5" />
            <circle class="globe-city" cx="26" cy="15" r="2" />
          </svg>
        </button>
        <nav class="dock-links" id="menu" aria-label="Main">
          <div>
            {[{ label: 'About me', href: '/' }, ...site.nav, { label: 'Contact', href: '/contact' }].map((item) => (
              <a href={item.href} aria-current={(item.href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(item.href)) ? 'page' : undefined}>{item.label}</a>
            ))}
          </div>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="foot">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <a href="/legal-notice">Legal notice</a>
      <a href="/privacy">Privacy</a>
    </footer>
    <script>
      // Hover (mouse or trackpad) and keyboard focus (not a mouse click's focus) open the dock through CSS. A tap or click toggles it, for touch;
      // tapping anywhere else or pressing Escape closes it again.
      const dock = document.querySelector<HTMLElement>('.dock')!;
      const globe = dock.querySelector<HTMLButtonElement>('.globe-button')!;
      const sync = () => globe.setAttribute('aria-expanded', String(dock.matches('.open, :hover, :has(:focus-visible)')));
      globe.addEventListener('click', () => { dock.classList.toggle('open'); sync(); });
      document.addEventListener('pointerdown', (event) => { if (!dock.contains(event.target as Node)) { dock.classList.remove('open'); sync(); } });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !dock.matches('.open, :has(:focus-visible)')) return;
        dock.classList.remove('open');
        globe.blur();
        sync();
      });
      for (const type of ['pointerenter', 'pointerleave', 'focusin', 'focusout']) dock.addEventListener(type, () => requestAnimationFrame(sync));
    </script>
  </body>
</html>
