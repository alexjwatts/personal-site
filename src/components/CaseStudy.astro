---
// The in-depth page behind "Read more", for a role or a project. Section names come from the page using it.
import Base from '../layouts/Base.astro';
import type { Entry } from '../site';

interface Props {
  job: Entry;
  back: { label: string; href: string };
  sections: { first: string; second: string; work: string; workPending?: string };
}

const { job, back, sections } = Astro.props;
const detail = job.detail!;
---

<Base title={job.title} description={job.summary}>
  <article class="case">
    <a class="case-back" href={`${back.href}#${job.slug}`}>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8H3M7.5 3.5 3 8l4.5 4.5" /></svg>
      {back.label}
    </a>

    <header class="case-head">
      <p class="case-when">{job.when}{job.where && ` · ${job.where}`}</p>
      <h1>{job.title}</h1>
      <p class="case-role">{job.role}</p>
      {job.pending && <p class="case-status">Incoming</p>}
      <p class="case-summary">{job.summary}</p>
    </header>

    <dl class="case-stats">
      {job.stats.map((stat) => (
        <div><dt>{stat.label}</dt><dd>{stat.value}</dd></div>
      ))}
    </dl>

    <section class="case-section">
      <h2><span>01</span> {sections.first}</h2>
      <div>{detail.company.map((paragraph) => <p>{paragraph}</p>)}</div>
    </section>

    <section class="case-section">
      <h2><span>02</span> {sections.second}</h2>
      <div>{detail.role.map((paragraph) => <p>{paragraph}</p>)}</div>
    </section>

    <section class="case-section">
      <h2><span>03</span> {job.pending && sections.workPending ? sections.workPending : sections.work}</h2>
      <ol class="case-work">
        {detail.work.map((area) => (
          <li>
            <h3>{area.title}</h3>
            <ul>{area.points.map((point) => <li>{point}</li>)}</ul>
          </li>
        ))}
      </ol>
    </section>

    {job.link && (
      <a class="case-link" href={job.link.href}>
        {job.link.label}
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M8.5 3.5 13 8l-4.5 4.5" /></svg>
      </a>
    )}

    {job.tools.length > 0 && (
      <section class="case-section">
        <h2><span>04</span> Tools</h2>
        <ul class="case-tools">{job.tools.map((tool) => <li>{tool}</li>)}</ul>
      </section>
    )}

    <div class="case-end">
      <a class="case-back case-back-end" href={`${back.href}#${job.slug}`}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8H3M7.5 3.5 3 8l4.5 4.5" /></svg>
        {back.label}
      </a>
    </div>
  </article>
</Base>

<style>
  /* Centered like the Experience page: header, numbers and section titles in the middle; long lists stay
     left-aligned inside a centered column so they're easy to read. */
  .case {
    max-width: 62rem;
    margin: 0 auto;
    text-align: center;
    padding: clamp(2rem, 6vh, 3.5rem) var(--gutter) clamp(1.75rem, 4vh, 2.5rem);
  }

  .case-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 1rem;
    text-decoration: none;
  }

  /* The story link and the bottom back arrow each sit on their own line, centered. */
  .case-link {
    display: flex;
    width: fit-content;
    margin-inline: auto;
    align-items: center;
    gap: 0.7rem;
    margin-top: clamp(2.5rem, 7vh, 4rem);
    padding: 0.7rem 1.35rem;
    border: 1px solid color-mix(in srgb, var(--text) 28%, transparent);
    border-radius: 999px;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.25s, box-shadow 0.25s;
  }

  .case-link:hover {
    border-color: var(--accent);
    box-shadow: 0 0 1.25rem color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .case-link svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .case-end {
    margin-top: clamp(2.5rem, 7vh, 4rem);
    padding-top: clamp(2rem, 5vh, 3rem);
    border-top: 1px solid var(--line);
  }

  /* Straight after a section, that section's own bottom line already does the job. */
  .case-section + .case-end {
    margin-top: 0;
    border-top: 0;
  }

  .case-back:hover {
    color: var(--text);
  }

  .case-back svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .case-head {
    margin-top: clamp(2rem, 6vh, 3.5rem);
  }

  .case-when {
    margin: 0;
    color: var(--muted);
  }

  .case h1 {
    margin-top: 0.5rem;
    font-size: clamp(3.5rem, 9vw, 6.5rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .case-role {
    margin: 1rem 0 0;
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    font-weight: 500;
  }

  .case-status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .case-status::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .case-summary {
    max-width: 40rem;
    margin: 1.25rem auto 0;
    color: var(--muted);
  }

  .case-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 2.5rem 0 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .case-stats div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.4rem;
    padding: 1.5rem 1rem;
  }

  .case-stats div + div {
    border-left: 1px solid var(--line);
  }

  .case-stats dd {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .case-stats dt {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  /* Numbered sections: the heading sits in a narrow column beside the content on wide screens. */
  .case-section {
    padding: clamp(2.5rem, 7vh, 4rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .case-section > :not(h2) {
    max-width: 40rem;
    margin-inline: auto;
  }

  .case-section h2 {
    margin-bottom: 1.5rem;
  }

  .case-section h2 {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .case-section h2 span {
    margin-right: 0.4rem;
    color: var(--accent);
  }

  .case-section p {
    margin: 0 0 1em;
  }

  .case-section p:last-child {
    margin-bottom: 0;
  }

  .case-work {
    display: grid;
    gap: 2rem;
    margin: 0 auto;
    text-align: left;
    padding: 0;
    list-style: none;
  }

  .case-work h3 {
    margin: 0 0 0.6rem;
    text-align: center;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .case-work ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-work ul li {
    position: relative;
    padding-left: 1.4rem;
  }

  .case-work ul li::before {
    content: '';
    position: absolute;
    top: 0.66em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .case-tools {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-tools li {
    padding: 0.3rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--text) 20%, transparent);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  @media (max-width: 899px) {
    .case-stats {
      grid-template-columns: 1fr;
    }

    .case-stats div,
    .case-stats div + div {
      padding: 1.25rem 0;
      border-left: 0;
    }

    .case-stats div + div {
      border-top: 1px solid var(--line);
    }
  }
</style>
