---
import Base from '../../layouts/Base.astro';
import { site } from '../../site';

// Newest first. Each build is a card; a lone card sits centered rather than leaving half the grid empty.
const builds = [...site.projects].sort((a, b) => b.start.localeCompare(a.start));
---

<Base title="AI Builds" description={site.buildsIntro}>
  <section class="builds-head">
    <h1 class="builds-title" data-duration="900">AI Builds</h1>
    <p>{site.buildsIntro}</p>
  </section>

  <ol class:list={['builds', { single: builds.length === 1 }]}>
    {builds.map((build, index) => (
      <li class="build" data-reveal style={`--delay: ${index * 120}ms`}>
        <a class="build-card" href={`/builds/${build.slug}`}>
          <div class="build-top">
            <h2>{build.title}</h2>
            {build.status && <span class:list={['build-status', { live: build.status.live }]}>{build.status.label}</span>}
          </div>
          <p class="build-role">{build.role}</p>
          <p class="build-summary">{build.summary}</p>
          {build.stats.length > 0 && (
            <dl class="build-stats">
              {build.stats.map((stat) => (
                <div><dd>{stat.value}</dd><dt>{stat.label}</dt></div>
              ))}
            </dl>
          )}
          <p class="build-foot">
            <span>{build.when}</span>
            <span class="build-more">
              Read more
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M8.5 3.5 13 8l-4.5 4.5" /></svg>
            </span>
          </p>
        </a>
      </li>
    ))}
  </ol>

  {/* The same "Scroll" cue as the homepage and Experience: there's more below the cards. It fades once you scroll. */}
  <div class="section-cue" aria-hidden="true">
    Scroll
    <svg viewBox="0 0 16 16"><path d="M8 3v10M3.5 8.5 8 13l4.5-4.5" /></svg>
  </div>

  {/* "How I like to work", a 2x2 under the cards. */}
  <section class="work" aria-labelledby="work-heading">
    <span class="work-link" aria-hidden="true"></span>
    <h2 id="work-heading" data-duration="700">{site.work.heading}</h2>
    <ul class="principles">
      {site.work.principles.map((p, index) => (
        <li data-reveal style={`--delay: ${(index % 2) * 140}ms`}>
          <h3>{p.text}</h3>
          <p>{p.why}</p>
        </li>
      ))}
    </ul>
    <p class="work-next">
      <a class="next-link" href={site.next.builds.href}>
        {site.next.builds.label}
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M8.5 3.5 13 8l-4.5 4.5" /></svg>
      </a>
    </p>
  </section>
</Base>

<style>
  /* "How I like to work": four principles, two by two at the same width as the build cards. No boxes. */
  .work {
    position: relative;
    max-width: 68rem;
    margin: 0 auto;
    padding: clamp(7rem, 22vh, 11rem) var(--gutter) clamp(4rem, 10vh, 6rem);
    text-align: center;
  }

  /* The soft transition: a thin line drops from the cards to a dot above the heading as you scroll,
     the same leg-of-the-route line that links the roles on the Experience page. */
  .work-link {
    --draw: 1;
    position: absolute;
    top: 0;
    left: 50%;
    width: 1px;
    height: calc(clamp(7rem, 22vh, 11rem) - 2.25rem);
    background: linear-gradient(transparent, var(--accent));
    transform: translateX(-50%) scaleY(var(--draw));
    transform-origin: top;
  }

  .work-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: -3.5px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    opacity: clamp(0, calc(var(--draw) * 4 - 3), 1);
  }

  .work h2 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.05;
    text-wrap: balance;
  }

  /* A line between the principles and the way on, like the other pages. */
  .work-next {
    margin: clamp(1rem, 3vh, 2rem) 0 0;
    padding-top: clamp(1.25rem, 3.5vh, 2rem);
    border-top: 1px solid var(--line);
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.5rem;
    margin: clamp(1.5rem, 4vh, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Each principle sits under a hairline: a tight bold line, then a short muted line.
     Each item spans two shared rows (subgrid), so the lines under the principles start level even when one principle wraps more. */
  .principles li {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
    justify-items: center;
    align-content: start;
    position: relative;
    padding: clamp(1.25rem, 3vh, 2.25rem) clamp(0.25rem, 1.5vw, 1.25rem) clamp(1.5rem, 3.5vh, 2.5rem);
  }

  /* The hairline above each principle; on scroll it draws out from the middle. */
  .principles li::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    border-top: 1px solid var(--line);
  }

  /* Scroll reveals, only once the script has confirmed motion is fine (so nothing hides without JavaScript).
     Things rise and fade in. */
  :global(html.motion) [data-reveal] {
    transition: opacity 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) var(--delay, 0ms), transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) var(--delay, 0ms);
  }

  :global(html.motion) [data-reveal]:not(.in) {
    opacity: 0;
    transform: translateY(1.75rem);
  }

  /* As "How I like to work" comes up, the cards lift away and dim a little, like the screens on the Experience page.
     --leave runs from 0 to 1 with the scroll; only transform and opacity change, so it stays smooth. */
  :global(html.motion) .builds {
    opacity: calc(1 - var(--leave, 0) * 0.85);
    transform: translateY(calc(var(--leave, 0) * -6rem + var(--pull, 0) * -1.5rem)) scale(calc(1 - var(--leave, 0) * 0.08));
    transform-origin: 50% 100%;
    will-change: transform, opacity;
  }

  /* While being pushed toward the next stop, the section gives a little, like the screens on the Experience page. */
  :global(html.motion) .work {
    transform: translateY(calc(var(--pull, 0) * -1.5rem));
  }

  /* The heading arrives with the scroll: it rises and grows into place as the cards leave. */
  :global(html.motion) .work h2 {
    opacity: calc(0.15 + var(--arrive, 1) * 0.85);
    transform: translateY(calc((1 - var(--arrive, 1)) * 3rem)) scale(calc(0.9 + var(--arrive, 1) * 0.1));
    will-change: transform, opacity;
  }

  :global(html.motion) .principles li::before {
    transform: scaleX(0);
    transition: transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) var(--delay, 0ms);
  }

  :global(html.motion) .principles li.in::before {
    transform: none;
  }

  .principles h3 {
    align-self: start;
    max-width: 30rem;
    font-size: clamp(1.375rem, 2.2vw, 1.625rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .principles p {
    align-self: start;
    max-width: 26rem;
    margin: 0.875rem 0 0;
    color: var(--muted);
    line-height: 1.5;
    text-wrap: pretty;
  }

  @media (max-width: 640px) {
    .principles {
      grid-template-columns: minmax(0, 1fr);
    }
  }


  .section-cue {
    position: fixed;
    z-index: 3;
    right: 0;
    bottom: 1.75rem;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    width: max-content;
    margin-inline: auto;
    color: var(--muted);
    font-size: 0.9375rem;
    pointer-events: none;
    animation: cue-rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) 1.4s both;
    transition: opacity 0.4s;
  }

  .section-cue svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: cue-nudge 1.8s ease-in-out 2s infinite;
  }

  .section-cue.gone {
    opacity: 0;
  }

  @keyframes cue-rise {
    from {
      opacity: 0;
      filter: blur(6px);
      transform: translateY(0.6em);
    }
  }

  @keyframes cue-nudge {
    0%, 60%, 100% { transform: none; }
    30% { transform: translateY(0.3rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-cue,
    .section-cue svg {
      animation: none;
    }
  }

  .builds-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(3rem, 9vh, 7rem) var(--gutter) clamp(2rem, 5vh, 3.5rem);
    text-align: center;
  }

  .builds-head h1 {
    font-size: clamp(3.5rem, 11vw, 8rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    white-space: nowrap;
  }

  .builds-head p {
    max-width: 36rem;
    margin: 1.5rem 0 0;
    color: var(--muted);
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.45;
  }

  /* Two columns of cards; each whole card is the link, outlined like the site's buttons and glowing on hover. */
  .builds {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    max-width: 68rem;
    margin: 0 auto;
    padding: 0 var(--gutter) clamp(4rem, 12vh, 7rem);
    list-style: none;
  }

  .builds.single {
    grid-template-columns: minmax(0, 36rem);
    justify-content: center;
  }

  .build-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid color-mix(in srgb, var(--text) 16%, transparent);
    border-radius: 1.25rem;
    text-decoration: none;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
  }

  .build-card:hover {
    border-color: var(--accent);
    box-shadow: 0 0 2rem color-mix(in srgb, var(--accent) 18%, transparent);
    transform: translateY(-2px);
  }

  .build-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .build-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
  }

  .build h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  /* Status reads like a stop on the route: a solid dot when finished or paused, a pulsing one while it runs. */
  .build-status {
    display: inline-flex;
    flex: none;
    max-width: 100%;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .build-status::before {
    content: '';
    width: 7px;
    height: 7px;
    border: 1px solid var(--muted);
    border-radius: 50%;
  }

  .build-status.live::before {
    border-color: var(--accent);
    background: var(--accent);
    animation: build-pulse 2.4s ease-out infinite;
  }

  @keyframes build-pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 50%, transparent);
    }

    70%,
    100% {
      box-shadow: 0 0 0 7px transparent;
    }
  }

  .build-role {
    margin: 0.5rem 0 0;
    color: var(--accent);
    font-weight: 500;
  }

  .build-summary {
    margin: 1rem 0 1.5rem;
    color: var(--muted);
  }

  /* Stats sit in equal columns pinned to the bottom of the card, number over label, so both cards line up. */
  .build-stats {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: 1.25rem;
    margin: auto 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .build-stats + .build-foot {
    margin-top: 0;
  }

  .build-stats div {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .build-stats dd {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .build-stats dt {
    color: var(--muted);
    min-height: 2.7em; /* room for two lines, so cards side by side keep their divider lines level */
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .build-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: auto 0 0;
    padding-top: 1.75rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .build-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    font-weight: 500;
  }

  .build-more svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s;
  }

  .build-card:hover .build-more svg {
    transform: translateX(0.25rem);
  }

  @media (max-width: 899px) {
    .builds {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .build-card,
    .build-status.live::before {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  import { pushScroll } from '../../scripts/push-scroll';

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const glyphs = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';

  // A title decodes from random characters, like the other section titles. Its box is held at its final size
  // while it decodes, so wider random letters can't wrap it onto another line and nudge the page below.
  const decode = (title: HTMLElement) => {
    const final = title.textContent!;
    const duration = Number(title.dataset.duration);
    // offsetWidth/offsetHeight are the layout size, ignoring the scale the heading has while it arrives.
    const width = title.offsetWidth;
    const height = title.offsetHeight;
    const oneLine = height < parseFloat(getComputedStyle(title).lineHeight) * 1.5;
    title.style.minWidth = `${width}px`;
    title.style.height = `${height}px`;
    if (oneLine) title.style.whiteSpace = 'nowrap';
    const start = performance.now();
    const step = (now: number) => {
      const done = Math.floor(((now - start) / duration) * final.length);
      title.textContent = [...final].map((letter, index) => (index < done || letter === ' ' ? letter : glyphs[Math.floor(Math.random() * glyphs.length)])).join('');
      if (now - start < duration) requestAnimationFrame(step);
      else { title.textContent = final; title.style.minWidth = ''; title.style.height = ''; title.style.whiteSpace = ''; }
    };
    requestAnimationFrame(step);
  };

  if (!still) {
    document.documentElement.classList.add('motion');
    decode(document.querySelector<HTMLElement>('.builds-title')!);

    // Cards and principles rise in as they come into view; the second heading decodes when it does.
    const heading = document.querySelector<HTMLElement>('#work-heading')!;
    const seen = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const target = entry.target as HTMLElement;
        if (target === heading) decode(heading);
        else target.classList.add('in');
        seen.unobserve(target);
      }
    }, { rootMargin: '0px 0px -12% 0px' });
    document.querySelectorAll('[data-reveal]').forEach((item) => seen.observe(item));
    seen.observe(heading);

    // The line between the sections draws with the scroll: empty while the section is below the fold,
    // complete once the heading is a little above the middle of the screen.
    const work = document.querySelector<HTMLElement>('.work')!;
    const link = work.querySelector<HTMLElement>('.work-link')!;
    const cards = document.querySelector<HTMLElement>('.builds')!;
    const cue = document.querySelector<HTMLElement>('.section-cue')!;
    const heading2 = work.querySelector<HTMLElement>('h2')!;
    const update = () => {
      const top = work.getBoundingClientRect().top;
      const draw = Math.max(0, Math.min(1, (innerHeight * 0.95 - top) / (innerHeight * 0.5)));
      link.style.setProperty('--draw', draw.toFixed(3));
      // The cards start to leave as the heading comes up the screen, and are nearly gone when it reaches the upper quarter.
      const headingTop = heading2.getBoundingClientRect().top;
      const leave = Math.max(0, Math.min(1, (innerHeight * 0.75 - headingTop) / (innerHeight * 0.4)));
      cards.style.setProperty('--leave', leave.toFixed(3));
      cue.classList.toggle('gone', scrollY > 40);
      // The heading has arrived once it reaches the upper half of the screen.
      const arrive = Math.max(0, Math.min(1, (innerHeight * 0.95 - headingTop) / (innerHeight * 0.4)));
      heading2.style.setProperty('--arrive', arrive.toFixed(3));
    };
    let frame = 0;
    addEventListener('scroll', () => { frame ||= requestAnimationFrame(() => { frame = 0; update(); }); }, { passive: true });
    addEventListener('resize', update);
    update();

    // Push-to-advance scrolling, like the Experience page: the cards, then "How I like to work" with the next-page
    // button, then the footer. The second section starts with just the end of the connecting line above the heading.
    const bar = document.querySelector<HTMLElement>('.bar')!;
    const nextButton = work.querySelector<HTMLElement>('.work-next')!;
    // Where an element sits in the page layout, ignoring the scroll-linked transforms.
    const pageTop = (element: HTMLElement) => {
      let top = 0;
      for (let node: HTMLElement | null = element; node; node = node.offsetParent as HTMLElement | null) top += node.offsetTop;
      return top;
    };
    const lastCard = cards.querySelector<HTMLElement>('.build:last-child')!;
    pushScroll({
      sections: () => [
        { top: 0, bottom: pageTop(lastCard) + lastCard.offsetHeight + 24 },
        { top: pageTop(heading2) - bar.offsetHeight - 24, bottom: pageTop(nextButton) + nextButton.offsetHeight + 24 },
      ],
      pullTargets: [cards, work],
    });
  }
</script>
